# ---------------------------------------------------------------------------
# CTF-Tutor configuration. Copy to .env and edit; every value has a default,
# so an empty .env still works.
# ---------------------------------------------------------------------------

# --- Local model ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Provider selection -----------------------------------------------------
# ollama (default) or openai_compatible for a local llama.cpp/vLLM/LM Studio server.
LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=local-model

# Optional failover chain, tried in order when the primary fails or times out.
# "offline" is a valid terminal entry: it returns nothing, which drops the agent
# back to its heuristic path instead of ending the session.
# LLM_PROVIDER_FALLBACK=openai_compatible,offline
# LLM_FAILOVER_COOLDOWN=60

# --- Runtime safety / performance ------------------------------------------
CTF_TUTOR_MAX_WORKERS=4
CTF_TUTOR_HISTORY_MAX_ENTRIES=400
CTF_TUTOR_MAX_DECOMPRESSED_BYTES=52428800
CTF_TUTOR_EVIDENCE_CHAR_LIMIT=1500
CTF_TUTOR_HEURISTIC_MIN_SCORE=2

# Highest capability the agent may use without asking:
# read_only | analysis | sandbox_exec | full_approval
CTF_TUTOR_MAX_PERMISSION=sandbox_exec

# --- Optional features ------------------------------------------------------
# Online research is off by default; everything works without it.
CTF_TUTOR_ONLINE_RESEARCH=0
CTF_TUTOR_USE_DOCKER=1
CTF_TUTOR_WEBUI_PORT=8765

# Plugins are local code that runs with your privileges, so they are opt-in.
CTF_TUTOR_ENABLE_PLUGINS=0
# CTF_TUTOR_PLUGIN_DIR=plugins

# --- Optional platform tokens (never required) ------------------------------
# CTFD_TOKEN=
# HTB_TOKEN=
# GHIDRA_INSTALL_DIR=
