<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dotnet-inspect</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- No external NuGet packages: System.Reflection.Metadata and
       System.Reflection.PortableExecutable are both part of the .NET
       base class library, so this builds offline once the SDK itself
       is installed. -->

</Project>
